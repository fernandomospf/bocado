generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sex {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum GoalType {
  LOSE
  MAINTAIN
  GAIN
}

enum WeekStart {
  MONDAY
  SUNDAY
}

enum AdaptiveAction {
  APPLIED
  DISMISSED
  SNOOZED
}

enum AdaptiveConfidence {
  LOW
  MEDIUM
  HIGH
}

enum WorkoutType {
  STRENGTH
  RUN
  BIKE
  WALK
  OTHER
}

enum WorkoutIntensity {
  LIGHT
  MODERATE
  HARD
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum MealSource {
  MANUAL
  PHOTO
  TEXT
  SEARCH
}

enum FoodSource {
  TACO
  CUSTOM
  /// Produto importado do Open Food Facts (compartilhado)
  OFF
  /// Produto lido do rótulo por um usuário (acervo compartilhado)
  LABEL
}

enum FoodStatus {
  ACTIVE
  /// Denunciado por 3 usuários: sai da busca até revisão
  REPORTED
  HIDDEN
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique
  name         String
  passwordHash String?
  googleId     String?       @unique
  avatarUrl    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  profile      Profile?
  meals        Meal[]
  foods        Food[]
  weights      WeightEntry[]
  recipes      Recipe[]
  contributed  Food[]        @relation("FoodContributor")
  aiUsage      AiUsage[]
  foodReports  FoodReport[]
  favoriteMeals FavoriteMeal[]
  adaptiveAdjustments AdaptiveAdjustment[]
  workouts     Workout[]
  householdMember HouseholdMember?
  householdInvites HouseholdInvite[] @relation("InviteCreator")

  @@map("users")
}

model Profile {
  userId          String        @id @db.Uuid
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sex             Sex
  birthDate       DateTime      @db.Date
  heightCm        Int
  weightKg        Float
  activityLevel   ActivityLevel
  goal            GoalType
  kcalTarget      Int
  proteinTarget   Int
  carbsTarget     Int
  fatTarget       Int
  customTargets   Boolean       @default(false)
  /// Peso usado no último cálculo/salvamento das metas (para avisar quando ficarem desatualizadas)
  targetsWeightKg Float?
  /// Primeiro dia da semana na faixa da tela Hoje e nos agrupamentos por semana
  weekStartsOn    WeekStart     @default(MONDAY)
  /// Relatórios semanais sem nenhuma informação de peso (média, variação e equivalente em kg)
  hideWeightInReports Boolean   @default(false)
  /// Meta adaptativa: sugerir ajustes da meta a partir do gasto estimado (nunca aplica sozinha)
  adaptiveEnabled     Boolean   @default(true)
  /// Sem novas sugestões até esta data (depois de "manter" ou "lembrar depois")
  adaptiveSnoozedUntil DateTime? @db.Date
  /// Treino como contexto: mostra a estimativa de gasto (desligada por padrão; é aproximada)
  workoutEstimateEnabled Boolean @default(false)
  /// Soma 50% do gasto estimado (líquido) à meta do dia. Só pode ficar ligada com a estimativa ligada
  workoutAddToGoal       Boolean @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("profiles")
}

model Meal {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime   @db.Date
  type      MealType
  source    MealSource @default(MANUAL)
  note      String?
  createdAt DateTime   @default(now())
  items     MealItem[]

  @@index([userId, date])
  @@map("meals")
}

model MealItem {
  id        String  @id @default(uuid()) @db.Uuid
  mealId    String  @db.Uuid
  meal      Meal    @relation(fields: [mealId], references: [id], onDelete: Cascade)
  name      String
  grams     Float
  kcal      Float
  protein   Float
  carbs     Float
  fat       Float
  /// Valores estimados pela IA (foto ou descrição) e não editados pelo usuário
  estimated Boolean @default(false)
  /// Receita de origem (para contar o uso). Nula em itens antigos ou se a receita for apagada
  recipeId  String? @db.Uuid
  recipe    Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([mealId])
  @@index([recipeId])
  @@map("meal_items")
}

/// Base de alimentos: TACO (pública, userId nulo) e alimentos CUSTOM de cada usuário. Valores por 100 g.
model Food {
  id              String             @id @default(uuid()) @db.Uuid
  name            String
  /// Nome em minúsculas, sem acento e sem pontuação, para a busca por trigramas
  searchName      String
  /// Nome natural para a interface ("Peito de frango grelhado"); nulo = usa o name
  displayName     String?
  category        String?
  source          FoodSource
  kcal100         Float
  protein100      Float
  carbs100        Float
  fat100          Float
  portionGrams    Float?
  portionLabel    String?
  userId          String?            @db.Uuid
  user            User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Produtos industrializados (OFF e LABEL): compartilhados, com userId nulo
  barcode         String?            @unique
  brand           String?
  /// Porção do rótulo, ex.: 30 g "30 g (1 xícara)"
  servingGrams    Float?
  servingLabel    String?
  /// Quem cadastrou um produto LABEL; o produto continua no acervo se a conta for apagada
  contributedById String?            @db.Uuid
  contributedBy   User?              @relation("FoodContributor", fields: [contributedById], references: [id], onDelete: SetNull)
  status          FoodStatus         @default(ACTIVE)
  reportCount     Int                @default(0)
  createdAt       DateTime           @default(now())
  ingredients     RecipeIngredient[]
  reports         FoodReport[]

  @@index([searchName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([userId])
  @@index([source, name])
  @@map("foods")
}

/// Cache negativo: códigos que o Open Food Facts não tem (ou tem incompletos), para não consultar de novo por 7 dias
model BarcodeMiss {
  code      String   @id
  checkedAt DateTime @default(now())

  @@map("barcode_misses")
}

/// Pesagens do usuário: no máximo uma por dia (registrar de novo no mesmo dia atualiza o valor).
/// A constraint única (userId, date) também serve de índice para as consultas por período.
model WeightEntry {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  weightKg  Float
  note      String?
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@map("weight_entries")
}

/// Receita caseira: ingredientes crus + peso final cozido. Valores por 100 g recalculados e gravados a cada save.
model Recipe {
  id               String             @id @default(uuid()) @db.Uuid
  ownerId          String             @db.Uuid
  owner            User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Casa com quem a receita é compartilhada. Nula = privada. Se a casa acabar, volta a ser privada
  householdId      String?            @db.Uuid
  household        Household?         @relation(fields: [householdId], references: [id], onDelete: SetNull)
  name             String
  notes            String?
  /// Peso final da panela; sem ele, a base é a soma dos gramas crus
  totalCookedGrams Float?
  servings         Int?
  kcal100          Float
  protein100       Float
  carbs100         Float
  fat100           Float
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  ingredients      RecipeIngredient[]
  usedIn           MealItem[]

  @@index([ownerId])
  @@index([householdId])
  @@map("recipes")
}

/// Ingrediente com os valores na quantidade informada (snapshot: não muda se o alimento de origem mudar)
model RecipeIngredient {
  id       String  @id @default(uuid()) @db.Uuid
  recipeId String  @db.Uuid
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  foodId   String? @db.Uuid
  food     Food?   @relation(fields: [foodId], references: [id], onDelete: SetNull)
  name     String
  grams    Float
  kcal     Float
  protein  Float
  carbs    Float
  fat      Float
  position Int

  @@index([recipeId])
  @@map("recipe_ingredients")
}

/// Respostas da IA para "Para fechar o dia", compartilhadas entre usuários com o mesmo déficit (30 dias)
model SuggestionCache {
  key       String    @id
  result    Json
  hits      Int       @default(0)
  createdAt DateTime  @default(now())
  lastHitAt DateTime?

  @@map("suggestion_cache")
}

/// Cache das análises por descrição de texto (fotos e rótulos nunca entram). Sem userId e sem a descrição original:
/// só o hash (descrição normalizada + modelo + versão do prompt) e o resultado. Validade de 90 dias.
model AnalysisCache {
  key       String    @id
  result    Json
  hits      Int       @default(0)
  createdAt DateTime  @default(now())
  lastHitAt DateTime?

  @@map("analysis_cache")
}

/// Refeição favorita: snapshot dos itens ([{name, grams, kcal, protein, carbs, fat}]), independente da refeição de origem
model FavoriteMeal {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  type       MealType?
  items      Json
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
  @@map("favorite_meals")
}

/// Decisões da pessoa sobre a meta adaptativa (não cada cálculo): aplicou, manteve ou adiou
model AdaptiveAdjustment {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @db.Uuid
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())
  action         AdaptiveAction
  windowStart    DateTime           @db.Date
  windowEnd      DateTime           @db.Date
  avgIntake      Float
  weightStartKg  Float
  weightEndKg    Float
  estimatedTdee  Float
  confidence     AdaptiveConfidence
  previousKcal   Int
  newKcal        Int?

  @@index([userId, createdAt])
  @@map("adaptive_adjustments")
}

/// Treino registrado: contexto do dia, não "calorias para comer". Não entra na meta salva nem na meta adaptativa.
model Workout {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime         @db.Date
  type        WorkoutType
  durationMin Int
  intensity   WorkoutIntensity
  note        String?
  createdAt   DateTime         @default(now())

  @@index([userId, date])
  @@map("workouts")
}

/// Contador diário de chamadas à IA por usuário e recurso (limite de uso)
model AiUsage {
  userId  String   @db.Uuid
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day     DateTime @db.Date
  feature String
  count   Int      @default(0)

  @@id([userId, day, feature])
  @@map("ai_usage")
}

/// Denúncia de dados errados num produto do acervo (uma por usuário e produto). 3 usuários → REPORTED.
model FoodReport {
  id        String   @id @default(uuid()) @db.Uuid
  foodId    String   @db.Uuid
  food      Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String
  createdAt DateTime @default(now())

  @@unique([foodId, userId])
  @@map("food_reports")
}

enum HouseholdRole {
  OWNER
  MEMBER
}

/// Casa: até 6 pessoas que compartilham receitas e podem dividir refeições. Nunca expõe diário, metas ou peso.
model Household {
  id        String            @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime          @default(now())
  members   HouseholdMember[]
  invites   HouseholdInvite[]
  recipes   Recipe[]

  @@map("households")
}

model HouseholdMember {
  id                String        @id @default(uuid()) @db.Uuid
  householdId       String        @db.Uuid
  household         Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  /// UNIQUE: no máximo uma casa por usuário
  userId            String        @unique @db.Uuid
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role              HouseholdRole @default(MEMBER)
  /// Refeições divididas por membros da casa entram direto no diário, sem oferta
  autoAcceptShared  Boolean       @default(false)
  joinedAt          DateTime      @default(now())

  @@index([householdId])
  @@map("household_members")
}

model HouseholdInvite {
  id          String    @id @default(uuid()) @db.Uuid
  householdId String    @db.Uuid
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  /// 8 caracteres, sem 0/O/1/I/L
  code        String    @unique
  createdById String    @db.Uuid
  createdBy   User      @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  usedAt      DateTime?
  /// Sem chave estrangeira: excluir a conta de quem entrou não pode depender do convite
  usedById    String?   @db.Uuid
  createdAt   DateTime  @default(now())

  @@index([householdId])
  @@map("household_invites")
}
