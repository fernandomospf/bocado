generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sex {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum GoalType {
  LOSE
  MAINTAIN
  GAIN
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum MealSource {
  MANUAL
  PHOTO
  TEXT
  SEARCH
}

enum FoodSource {
  TACO
  CUSTOM
  /// Produto importado do Open Food Facts (compartilhado)
  OFF
  /// Produto lido do rótulo por um usuário (acervo compartilhado)
  LABEL
}

enum FoodStatus {
  ACTIVE
  /// Denunciado por 3 usuários: sai da busca até revisão
  REPORTED
  HIDDEN
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique
  name         String
  passwordHash String?
  googleId     String?       @unique
  avatarUrl    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  profile      Profile?
  meals        Meal[]
  foods        Food[]
  weights      WeightEntry[]
  recipes      Recipe[]
  contributed  Food[]        @relation("FoodContributor")
  aiUsage      AiUsage[]

  @@map("users")
}

model Profile {
  userId          String        @id @db.Uuid
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sex             Sex
  birthDate       DateTime      @db.Date
  heightCm        Int
  weightKg        Float
  activityLevel   ActivityLevel
  goal            GoalType
  kcalTarget      Int
  proteinTarget   Int
  carbsTarget     Int
  fatTarget       Int
  customTargets   Boolean       @default(false)
  /// Peso usado no último cálculo/salvamento das metas (para avisar quando ficarem desatualizadas)
  targetsWeightKg Float?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("profiles")
}

model Meal {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime   @db.Date
  type      MealType
  source    MealSource @default(MANUAL)
  note      String?
  createdAt DateTime   @default(now())
  items     MealItem[]

  @@index([userId, date])
  @@map("meals")
}

model MealItem {
  id      String @id @default(uuid()) @db.Uuid
  mealId  String @db.Uuid
  meal    Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)
  name    String
  grams   Float
  kcal    Float
  protein Float
  carbs   Float
  fat     Float

  @@index([mealId])
  @@map("meal_items")
}

/// Base de alimentos: TACO (pública, userId nulo) e alimentos CUSTOM de cada usuário. Valores por 100 g.
model Food {
  id              String             @id @default(uuid()) @db.Uuid
  name            String
  /// Nome em minúsculas, sem acento e sem pontuação, para a busca por trigramas
  searchName      String
  category        String?
  source          FoodSource
  kcal100         Float
  protein100      Float
  carbs100        Float
  fat100          Float
  portionGrams    Float?
  portionLabel    String?
  userId          String?            @db.Uuid
  user            User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Produtos industrializados (OFF e LABEL): compartilhados, com userId nulo
  barcode         String?            @unique
  brand           String?
  /// Porção do rótulo, ex.: 30 g "30 g (1 xícara)"
  servingGrams    Float?
  servingLabel    String?
  /// Quem cadastrou um produto LABEL; o produto continua no acervo se a conta for apagada
  contributedById String?            @db.Uuid
  contributedBy   User?              @relation("FoodContributor", fields: [contributedById], references: [id], onDelete: SetNull)
  status          FoodStatus         @default(ACTIVE)
  reportCount     Int                @default(0)
  createdAt       DateTime           @default(now())
  ingredients     RecipeIngredient[]

  @@index([searchName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([userId])
  @@index([source, name])
  @@map("foods")
}

/// Cache negativo: códigos que o Open Food Facts não tem (ou tem incompletos), para não consultar de novo por 7 dias
model BarcodeMiss {
  code      String   @id
  checkedAt DateTime @default(now())

  @@map("barcode_misses")
}

/// Pesagens do usuário: no máximo uma por dia (registrar de novo no mesmo dia atualiza o valor).
/// A constraint única (userId, date) também serve de índice para as consultas por período.
model WeightEntry {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  weightKg  Float
  note      String?
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@map("weight_entries")
}

/// Receita caseira: ingredientes crus + peso final cozido. Valores por 100 g recalculados e gravados a cada save.
model Recipe {
  id               String             @id @default(uuid()) @db.Uuid
  ownerId          String             @db.Uuid
  owner            User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Casa com quem a receita é compartilhada (a chave estrangeira entra com a tabela de casas)
  householdId      String?            @db.Uuid
  name             String
  notes            String?
  /// Peso final da panela; sem ele, a base é a soma dos gramas crus
  totalCookedGrams Float?
  servings         Int?
  kcal100          Float
  protein100       Float
  carbs100         Float
  fat100           Float
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  ingredients      RecipeIngredient[]

  @@index([ownerId])
  @@index([householdId])
  @@map("recipes")
}

/// Ingrediente com os valores na quantidade informada (snapshot: não muda se o alimento de origem mudar)
model RecipeIngredient {
  id       String  @id @default(uuid()) @db.Uuid
  recipeId String  @db.Uuid
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  foodId   String? @db.Uuid
  food     Food?   @relation(fields: [foodId], references: [id], onDelete: SetNull)
  name     String
  grams    Float
  kcal     Float
  protein  Float
  carbs    Float
  fat      Float
  position Int

  @@index([recipeId])
  @@map("recipe_ingredients")
}

/// Respostas da IA para "Para fechar o dia", compartilhadas entre usuários com o mesmo déficit (30 dias)
model SuggestionCache {
  key       String    @id
  result    Json
  hits      Int       @default(0)
  createdAt DateTime  @default(now())
  lastHitAt DateTime?

  @@map("suggestion_cache")
}

/// Contador diário de chamadas à IA por usuário e recurso (limite de uso)
model AiUsage {
  userId  String   @db.Uuid
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day     DateTime @db.Date
  feature String
  count   Int      @default(0)

  @@id([userId, day, feature])
  @@map("ai_usage")
}
