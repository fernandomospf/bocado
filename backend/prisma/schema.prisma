generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sex {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum GoalType {
  LOSE
  MAINTAIN
  GAIN
}

enum WeekStart {
  MONDAY
  SUNDAY
}

enum AdaptiveAction {
  APPLIED
  DISMISSED
  SNOOZED
}

enum AdaptiveConfidence {
  LOW
  MEDIUM
  HIGH
}

enum WorkoutType {
  STRENGTH
  RUN
  BIKE
  WALK
  OTHER
}

enum WorkoutIntensity {
  LIGHT
  MODERATE
  HARD
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum MealSource {
  MANUAL
  PHOTO
  TEXT
  SEARCH
}

enum FoodSource {
  TACO
  CUSTOM
  /// Produto importado do Open Food Facts (compartilhado)
  OFF
  /// Produto lido do rótulo por um usuário (acervo compartilhado)
  LABEL
}

enum FoodStatus {
  ACTIVE
  /// Denunciado por 3 usuários: sai da busca até revisão
  REPORTED
  HIDDEN
  /// Duplicado unido a outro produto (mergedIntoId): some da busca e redireciona para o canônico
  MERGED
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique
  name         String
  passwordHash String?
  googleId     String?       @unique
  avatarUrl    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  profile      Profile?
  meals        Meal[]
  foods        Food[]
  weights      WeightEntry[]
  recipes      Recipe[]
  contributed  Food[]        @relation("FoodContributor")
  aiUsage      AiUsage[]
  foodReports  FoodReport[]
  foodConfirmations FoodConfirmation[]
  favoriteMeals FavoriteMeal[]
  adaptiveAdjustments AdaptiveAdjustment[]
  workouts     Workout[]
  supplementPlans SupplementPlan[]
  intakeLogs   IntakeLog[]
  wellbeingLogs WellbeingLog[]
  fastingSessions FastingSession[]
  /// Multiplicador dos limites de IA (0 = IA bloqueada para a pessoa, 2 = dobro). Só o admin altera
  aiLimitFactor Float @default(1)
  householdMember HouseholdMember?
  householdInvites HouseholdInvite[] @relation("InviteCreator")
  waterEntries   WaterEntry[]
  waterDays      WaterDay[]
  mealsSharedByMe Meal[] @relation("MealSharedBy")
  betaInvitesCreated BetaInvite[] @relation("BetaInviteCreator")
  betaInviteUse  BetaInviteUse?
  offersSent     SharedMealOffer[] @relation("OfferFrom")
  offersReceived SharedMealOffer[] @relation("OfferTo")

  @@map("users")
}

model Profile {
  userId          String        @id @db.Uuid
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sex             Sex
  birthDate       DateTime      @db.Date
  heightCm        Int
  weightKg        Float
  activityLevel   ActivityLevel
  goal            GoalType
  kcalTarget      Int
  proteinTarget   Int
  carbsTarget     Int
  fatTarget       Int
  customTargets   Boolean       @default(false)
  /// Peso usado no último cálculo/salvamento das metas (para avisar quando ficarem desatualizadas)
  targetsWeightKg Float?
  /// Primeiro dia da semana na faixa da tela Hoje e nos agrupamentos por semana
  weekStartsOn    WeekStart     @default(MONDAY)
  /// Relatórios semanais sem nenhuma informação de peso (média, variação e equivalente em kg)
  hideWeightInReports Boolean   @default(false)
  /// Modo "esconder calorias": só a interface muda (proteína e constância). O backend guarda e devolve tudo
  hideCalories        Boolean   @default(false)
  /// Meta de peso (só referência para o gráfico e o progresso; não altera metas de calorias). Início = tendência no dia em que foi definida
  goalWeightKg        Float?
  goalStartWeightKg   Float?
  goalSetAt           DateTime? @db.Date
  /// Contador de água
  waterEnabled        Boolean        @default(true)
  waterGoalMode       WaterGoalMode  @default(AUTO)
  waterGoalManualMl   Int?
  waterBottleMl       Int?
  /// Meta adaptativa: sugerir ajustes da meta a partir do gasto estimado (nunca aplica sozinha)
  adaptiveEnabled     Boolean   @default(true)
  /// Sem novas sugestões até esta data (depois de "manter" ou "lembrar depois")
  adaptiveSnoozedUntil DateTime? @db.Date
  /// Treino como contexto: mostra a estimativa de gasto (padrão ligado só para contas novas; é aproximada)
  workoutEstimateEnabled Boolean @default(true)
  /// Medidor de movimento (minutos do dia x meta diária). Meta só de referência: não altera metas de calorias nem de água
  movementEnabled        Boolean @default(true)
  /// OBSOLETA: meta semanal antiga (30 a 600). Fica no banco, sem uso; vale `movementDailyGoalMin`
  movementGoalMin        Int?    @default(150)
  /// Meta diária em minutos (15 a 240, múltiplo de 5). Nula para menores de 18 até a pessoa definir a sua
  movementDailyGoalMin   Int?    @default(30)
  /// Dias de descanso (0 = domingo … 6 = sábado): sem meta nesses dias
  movementRestDays       Int[]   @default([])
  /// Soma 50% do gasto estimado (líquido) à meta do dia. Só pode ficar ligada com a estimativa ligada
  workoutAddToGoal       Boolean @default(false)
  /// Registro pessoal de suplementos e medicações (dado sensível, desligado por padrão; indisponível a menores de 18)
  supplementsEnabled     Boolean @default(false)
  /// Na tela Hoje, mostra "Medicação 1" / "Suplemento 2" em vez do nome
  supplementsMaskNamesOnHome Boolean @default(false)
  /// Modo GLP-1 (dado sensível, desligado por padrão; indisponível a menores de 18). Só ajusta a interface (proteína,
  /// água, bem-estar) e pausa a meta adaptativa. O Bocado não orienta sobre a medicação
  glp1Mode               Boolean @default(false)
  /// Piso de proteína em g/dia (referência geral, editável). Nulo = usa a sugestão calculada
  proteinFloorG          Int?
  /// Jejum intermitente (dado sensível, desligado por padrão; indisponível a menores de 18). O Bocado só registra a janela
  fastingEnabled         Boolean @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("profiles")
}

model Meal {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime   @db.Date
  type      MealType
  source    MealSource @default(MANUAL)
  note      String?
  createdAt DateTime   @default(now())
  items     MealItem[]
  /// Refeição dividida com a casa: todas as cópias (de quem enviou e de quem recebeu) compartilham o grupo
  sharedGroupId String?  @db.Uuid
  /// Quem dividiu. Vira nulo se essa pessoa excluir a conta; a cópia continua no diário de quem recebeu
  sharedById    String?  @db.Uuid
  sharedBy      User?    @relation("MealSharedBy", fields: [sharedById], references: [id], onDelete: SetNull)
  /// Fração da refeição original que ficou com este diário (0 a 1)
  share         Float?

  @@index([userId, date])
  @@index([sharedGroupId])
  @@map("meals")
}

model MealItem {
  id        String  @id @default(uuid()) @db.Uuid
  mealId    String  @db.Uuid
  meal      Meal    @relation(fields: [mealId], references: [id], onDelete: Cascade)
  name      String
  grams     Float
  kcal      Float
  protein   Float
  carbs     Float
  fat       Float
  /// Valores estimados pela IA (foto ou descrição) e não editados pelo usuário
  estimated Boolean @default(false)
  /// Receita de origem (para contar o uso). Nula em itens antigos ou se a receita for apagada
  recipeId  String? @db.Uuid
  recipe    Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([mealId])
  @@index([recipeId])
  @@map("meal_items")
}

/// Base de alimentos: TACO (pública, userId nulo) e alimentos CUSTOM de cada usuário. Valores por 100 g.
model Food {
  id              String             @id @default(uuid()) @db.Uuid
  name            String
  /// Nome em minúsculas, sem acento e sem pontuação, para a busca por trigramas
  searchName      String
  /// Nome natural para a interface ("Peito de frango grelhado"); nulo = usa o name
  displayName     String?
  category        String?
  source          FoodSource
  kcal100         Float
  protein100      Float
  carbs100        Float
  fat100          Float
  portionGrams    Float?
  portionLabel    String?
  userId          String?            @db.Uuid
  user            User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Produtos industrializados (OFF e LABEL): compartilhados, com userId nulo
  barcode         String?            @unique
  brand           String?
  /// Porção do rótulo, ex.: 30 g "30 g (1 xícara)"
  servingGrams    Float?
  servingLabel    String?
  /// Quem cadastrou um produto LABEL; o produto continua no acervo se a conta for apagada
  contributedById String?            @db.Uuid
  contributedBy   User?              @relation("FoodContributor", fields: [contributedById], references: [id], onDelete: SetNull)
  status          FoodStatus         @default(ACTIVE)
  reportCount     Int                @default(0)
  /// Confirmações de pessoas diferentes (o criador não conta). Com 2 ou mais, o produto ganha o selo "Verificado"
  verifyCount     Int                @default(0)
  /// Produto canônico para o qual este duplicado foi unido (status MERGED). Nada é apagado
  mergedIntoId    String?            @db.Uuid
  mergedInto      Food?              @relation("FoodMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom      Food[]             @relation("FoodMerge")
  confirmations   FoodConfirmation[]
  createdAt       DateTime           @default(now())
  ingredients     RecipeIngredient[]
  reports         FoodReport[]

  @@index([searchName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([userId])
  @@index([source, name])
  @@index([mergedIntoId])
  @@map("foods")
}

/// Cache negativo: códigos que o Open Food Facts não tem (ou tem incompletos), para não consultar de novo por 7 dias
model BarcodeMiss {
  code      String   @id
  checkedAt DateTime @default(now())

  @@map("barcode_misses")
}

/// Pesagens do usuário: no máximo uma por dia (registrar de novo no mesmo dia atualiza o valor).
/// A constraint única (userId, date) também serve de índice para as consultas por período.
model WeightEntry {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  weightKg  Float
  note      String?
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@map("weight_entries")
}

/// Receita caseira: ingredientes crus + peso final cozido. Valores por 100 g recalculados e gravados a cada save.
model Recipe {
  id               String             @id @default(uuid()) @db.Uuid
  ownerId          String             @db.Uuid
  owner            User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Casa com quem a receita é compartilhada. Nula = privada. Se a casa acabar, volta a ser privada
  householdId      String?            @db.Uuid
  household        Household?         @relation(fields: [householdId], references: [id], onDelete: SetNull)
  name             String
  notes            String?
  /// Peso final da panela; sem ele, a base é a soma dos gramas crus
  totalCookedGrams Float?
  servings         Int?
  kcal100          Float
  protein100       Float
  carbs100         Float
  fat100           Float
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  ingredients      RecipeIngredient[]
  usedIn           MealItem[]

  @@index([ownerId])
  @@index([householdId])
  @@map("recipes")
}

/// Ingrediente com os valores na quantidade informada (snapshot: não muda se o alimento de origem mudar)
model RecipeIngredient {
  id       String  @id @default(uuid()) @db.Uuid
  recipeId String  @db.Uuid
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  foodId   String? @db.Uuid
  food     Food?   @relation(fields: [foodId], references: [id], onDelete: SetNull)
  name     String
  grams    Float
  kcal     Float
  protein  Float
  carbs    Float
  fat      Float
  position Int

  @@index([recipeId])
  @@map("recipe_ingredients")
}

/// Respostas da IA para "Para fechar o dia", compartilhadas entre usuários com o mesmo déficit (30 dias)
model SuggestionCache {
  key       String    @id
  result    Json
  hits      Int       @default(0)
  createdAt DateTime  @default(now())
  lastHitAt DateTime?

  @@map("suggestion_cache")
}

/// Cache das análises por descrição de texto (fotos e rótulos nunca entram). Sem userId e sem a descrição original:
/// só o hash (descrição normalizada + modelo + versão do prompt) e o resultado. Validade de 90 dias.
model AnalysisCache {
  key       String    @id
  result    Json
  hits      Int       @default(0)
  createdAt DateTime  @default(now())
  lastHitAt DateTime?

  @@map("analysis_cache")
}

/// Refeição favorita: snapshot dos itens ([{name, grams, kcal, protein, carbs, fat}]), independente da refeição de origem
model FavoriteMeal {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  type       MealType?
  items      Json
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
  @@map("favorite_meals")
}

/// Decisões da pessoa sobre a meta adaptativa (não cada cálculo): aplicou, manteve ou adiou
model AdaptiveAdjustment {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @db.Uuid
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())
  action         AdaptiveAction
  windowStart    DateTime           @db.Date
  windowEnd      DateTime           @db.Date
  avgIntake      Float
  weightStartKg  Float
  weightEndKg    Float
  estimatedTdee  Float
  confidence     AdaptiveConfidence
  previousKcal   Int
  newKcal        Int?

  @@index([userId, createdAt])
  @@map("adaptive_adjustments")
}

/// Treino registrado: contexto do dia, não "calorias para comer". Não entra na meta salva nem na meta adaptativa.
model Workout {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime         @db.Date
  type        WorkoutType
  durationMin Int
  intensity   WorkoutIntensity
  note        String?
  createdAt   DateTime         @default(now())

  @@index([userId, date])
  @@map("workouts")
}

enum AiFeature {
  PHOTO
  TEXT
  LABEL
  SUGGEST
}

enum AiUsageStatus {
  PENDING
  OK
  FAILED
}

/// Uma chamada à IA (sem conteúdo: nada de descrição, imagem ou resposta). Reservada antes da chamada (PENDING) e
/// fechada depois (OK com os tokens do SDK, ou FAILED). Só OK e PENDING contam nos limites. Ao excluir a conta,
/// o registro fica anônimo (userId nulo): serve só para o custo total
model AiUsage {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String?       @db.Uuid
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  feature      AiFeature
  model        String
  status       AiUsageStatus @default(PENDING)
  inputTokens  Int           @default(0)
  outputTokens Int           @default(0)
  createdAt    DateTime      @default(now())
  settledAt    DateTime?

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("ai_usage")
}

/// Denúncia de dados errados num produto do acervo (uma por usuário e produto). 3 usuários → REPORTED.
model FoodReport {
  id        String   @id @default(uuid()) @db.Uuid
  foodId    String   @db.Uuid
  food      Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String
  createdAt DateTime @default(now())

  @@unique([foodId, userId])
  @@map("food_reports")
}

/// "Os valores conferem com o rótulo": uma confirmação por pessoa e produto. O criador do produto não confirma o próprio
model FoodConfirmation {
  id        String   @id @default(uuid()) @db.Uuid
  foodId    String   @db.Uuid
  food      Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([foodId, userId])
  @@map("food_confirmations")
}

enum HouseholdRole {
  OWNER
  MEMBER
}

/// Casa: até 6 pessoas que compartilham receitas e podem dividir refeições. Nunca expõe diário, metas ou peso.
model Household {
  id        String            @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime          @default(now())
  members   HouseholdMember[]
  invites   HouseholdInvite[]
  recipes   Recipe[]

  @@map("households")
}

model HouseholdMember {
  id                String        @id @default(uuid()) @db.Uuid
  householdId       String        @db.Uuid
  household         Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  /// UNIQUE: no máximo uma casa por usuário
  userId            String        @unique @db.Uuid
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role              HouseholdRole @default(MEMBER)
  /// Refeições divididas por membros da casa entram direto no diário, sem oferta
  autoAcceptShared  Boolean       @default(false)
  joinedAt          DateTime      @default(now())

  @@index([householdId])
  @@map("household_members")
}

model HouseholdInvite {
  id          String    @id @default(uuid()) @db.Uuid
  householdId String    @db.Uuid
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  /// 8 caracteres, sem 0/O/1/I/L
  code        String    @unique
  createdById String    @db.Uuid
  createdBy   User      @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  usedAt      DateTime?
  /// Sem chave estrangeira: excluir a conta de quem entrou não pode depender do convite
  usedById    String?   @db.Uuid
  createdAt   DateTime  @default(now())

  @@index([householdId])
  @@map("household_invites")
}

/// Oferta de refeição dividida: chega à pessoa como convite e só vira refeição no diário dela se ela aceitar
model SharedMealOffer {
  id         String     @id @default(uuid()) @db.Uuid
  groupId    String     @db.Uuid
  fromUserId String     @db.Uuid
  from       User       @relation("OfferFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String     @db.Uuid
  to         User       @relation("OfferTo", fields: [toUserId], references: [id], onDelete: Cascade)
  date       DateTime   @db.Date
  type       MealType
  source     MealSource
  /// Fração da refeição original que cabe a quem recebe
  share      Float
  /// Alimentos já escalados pela fração: [{ name, grams, kcal, protein, carbs, fat, estimated }]
  items      Json
  createdAt  DateTime   @default(now())
  expiresAt  DateTime

  @@index([toUserId])
  @@index([groupId])
  @@map("shared_meal_offers")
}

// ---------------------------------------------------------------------------
// Acesso por convite do beta (NÃO é o convite da casa: HouseholdInvite)
// ---------------------------------------------------------------------------

enum WaitlistStatus {
  PENDING
  INVITED
  JOINED
}

/// Convite do beta fechado. O uso é consumido com um UPDATE atômico (uses < maxUses), nunca por leitura + escrita
model BetaInvite {
  id          String          @id @default(uuid()) @db.Uuid
  /// 8 caracteres, sem 0/O/1/I/L
  code        String          @unique
  /// Para quem é (e-mail da lista de espera ou um rótulo livre)
  label       String
  maxUses     Int             @default(1)
  uses        Int             @default(0)
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime        @default(now())
  createdById String?         @db.Uuid
  createdBy   User?           @relation("BetaInviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  usesList    BetaInviteUse[]
  waitlist    WaitlistEntry[]

  @@map("beta_invites")
}

/// Quem entrou por qual convite. Cai junto com a conta (Cascade)
model BetaInviteUse {
  id       String     @id @default(uuid()) @db.Uuid
  inviteId String     @db.Uuid
  invite   BetaInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  userId   String     @unique @db.Uuid
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  usedAt   DateTime   @default(now())

  @@index([inviteId])
  @@map("beta_invite_uses")
}

/// Lista de espera do beta. Guarda só e-mail, nome opcional e o consentimento: sem IP e sem user-agent
model WaitlistEntry {
  id        String         @id @default(uuid()) @db.Uuid
  /// Minúsculo e sem espaços nas pontas
  email     String         @unique
  name      String?
  status    WaitlistStatus @default(PENDING)
  inviteId  String?        @db.Uuid
  invite    BetaInvite?    @relation(fields: [inviteId], references: [id], onDelete: SetNull)
  consentAt DateTime
  createdAt DateTime       @default(now())
  invitedAt DateTime?

  @@index([status, createdAt])
  @@map("waitlist_entries")
}

enum WaterGoalMode {
  AUTO
  MANUAL
}

/// Um registro de água (copo, garrafa…). A água dos alimentos e bebidas das refeições NÃO entra aqui
model WaterEntry {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  amountMl  Int
  createdAt DateTime @default(now())

  @@index([userId, date])
  @@map("water_entries")
}

/// A meta de água que valia naquele dia. Dias passados nunca são recalculados
model WaterDay {
  userId String   @db.Uuid
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date
  goalMl Int

  @@id([userId, date])
  @@map("water_days")
}

// ---------------------------------------------------------------------------
// Suplementos e medicações: SÓ registra o que a pessoa informa (nada é recomendado, calculado ou validado).
// Dado sensível: privado por padrão, isolado do resto do app (nunca entra em relatórios, casa, admin, IA nem logs).
// ---------------------------------------------------------------------------

enum SupplementCategory {
  MEDICATION
  SUPPLEMENT
  VITAMIN
  OTHER
}

enum DoseUnit {
  ML
  MG
  MCG
  G
  UI
  TABLET
  CAPSULE
  SCOOP
  DROP
  OTHER
}

enum Administration {
  ORAL
  INJECTION
  OTHER
}

enum ScheduleType {
  DAILY
  WEEKDAYS
  EVERY_N_DAYS
}

enum Slot {
  ANY
  MORNING
  AFTERNOON
  NIGHT
}

enum InjectionSite {
  ABDOMEN_L
  ABDOMEN_R
  THIGH_L
  THIGH_R
  GLUTE_L
  GLUTE_R
  DELTOID_L
  DELTOID_R
  OTHER
}

enum IntakeStatus {
  TAKEN
  SKIPPED
}

model SupplementPlan {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @db.Uuid
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  category       SupplementCategory
  administration Administration     @default(ORAL)
  /// Exatamente o que a pessoa digitou: o app não valida faixa nem converte unidades
  doseAmount     Float
  doseUnit       DoseUnit
  /// Texto livre da unidade (obrigatório com doseUnit = OTHER)
  doseUnitLabel  String?
  scheduleType   ScheduleType
  /// 0 = domingo … 6 = sábado (scheduleType = WEEKDAYS)
  weekdays       Int[]
  /// 2 a 90 (scheduleType = EVERY_N_DAYS, "rolling": conta a partir do último registro)
  intervalDays   Int?
  slots          Slot[]             @default([ANY])
  startDate      DateTime           @db.Date
  endDate        DateTime?          @db.Date
  notes          String?
  /// Só vale com administration = INJECTION
  trackSite      Boolean            @default(false)
  showOnWeightChart Boolean         @default(false)
  archivedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  logs           IntakeLog[]

  @@index([userId, archivedAt])
  @@map("supplement_plans")
}

model IntakeLog {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId         String         @db.Uuid
  plan           SupplementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// Dia local PREVISTO (não o dia em que foi tocado o botão; para isso há `takenAt`)
  date           DateTime       @db.Date
  slot           Slot           @default(ANY)
  status         IntakeStatus
  takenAt        DateTime?
  /// Snapshot da dose da época: mudar a dose do plano NÃO altera o histórico
  doseAmount     Float
  doseUnit       DoseUnit
  doseUnitLabel  String?
  site           InjectionSite?
  note           String?
  createdAt      DateTime       @default(now())

  @@unique([planId, date, slot])
  @@index([userId, date])
  @@map("intake_logs")
}

// ---------------------------------------------------------------------------
// Bem-estar (modo GLP-1 ou suplementos): dado de saúde, privado. Nunca vai para a casa, o admin, a IA, analytics nem logs.
// ---------------------------------------------------------------------------

/// Como a pessoa se sentiu no dia, em escalas de 0 a 3 (nulas = não respondeu). Uma linha por dia
model WellbeingLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  nausea    Int?
  appetite  Int?
  energy    Int?
  gi        Int?
  note      String?
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@map("wellbeing_logs")
}

// ---------------------------------------------------------------------------
// Jejum intermitente: só REGISTRA a janela que a pessoa escolhe (não prescreve jejum). Dado de saúde, privado: nunca
// vai para a casa, o admin, a IA, analytics nem logs. Horários em UTC; o app exibe no fuso do aparelho.
// ---------------------------------------------------------------------------

/// Uma janela de jejum. No máximo UMA ativa (endedAt nulo) por pessoa: índice único parcial na migration
model FastingSession {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt   DateTime
  endedAt     DateTime?
  /// Meta em horas (12 a 20): só referência para a barra de progresso
  targetHours Int
  note        String?
  createdAt   DateTime  @default(now())

  @@index([userId, startedAt])
  @@map("fasting_sessions")
}
