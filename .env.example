# ---- Banco ----
POSTGRES_USER=bocado
# Use só caracteres seguros para URL: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=bocado

# ---- App ----
# URL pública do app (sem barra no final), ex.: https://bocado.seudominio.com
APP_URL=
# Mínimo 32 caracteres: openssl rand -hex 32
JWT_SECRET=
# Deixe true em produção (HTTPS). Use false só em http://localhost
COOKIE_SECURE=true

# ---- Beta por convite (opcional; sem isso o cadastro continua aberto) ----
# "open" (padrão): qualquer pessoa pode criar conta. "invite": só com código de convite do beta.
REGISTRATION_MODE=open
# Limite de usuários do beta (inteiro). Em branco = sem limite. Bloqueia NOVOS cadastros ao chegar nele,
# mesmo com convite válido.
BETA_MAX_USERS=
# E-mails (separados por vírgula) que acessam o painel /admin. Vale só para contas que JÁ existem.
ADMIN_EMAILS=
# Cloudflare Turnstile na lista de espera (opcional). A chave secreta fica no backend; a chave pública
# (NEXT_PUBLIC_TURNSTILE_SITEKEY) é um build arg do frontend. Se TURNSTILE_SECRET existir, o formulário exige o token.
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITEKEY=

# ---- IA (análise por foto e descrição) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Modelo por funcionalidade (opcional): em branco, vale ANTHROPIC_MODEL. Trocar o modelo de TEXT invalida o cache das
# descrições (o modelo entra na chave do cache, junto com a versão do prompt).
ANTHROPIC_MODEL_PHOTO=
ANTHROPIC_MODEL_TEXT=
ANTHROPIC_MODEL_LABEL=
ANTHROPIC_MODEL_SUGGEST=

# ---- Limites de uso de IA e custo (opcionais; os valores abaixo são os padrões) ----
# Limite DIÁRIO por pessoa e funcionalidade. Falhas não consomem cota; acerto de cache também não.
AI_DAILY_LIMIT_PHOTO=8
AI_DAILY_LIMIT_TEXT=15
AI_DAILY_LIMIT_LABEL=4
AI_DAILY_LIMIT_SUGGEST=3
# Limite MENSAL por pessoa, somando todas as funcionalidades.
AI_MONTHLY_LIMIT_TOTAL=200
# O "dia" e o "mês" da cota seguem este fuso.
AI_QUOTA_TZ=America/Sao_Paulo
# Teto global do mês em dólares (opcional). Ao chegar em 100%, a IA entra em pausa para todos até o mês seguinte.
# Só funciona se o modelo estiver em AI_PRICES_JSON; sem preços, o teto em dólares fica inativo.
AI_MONTHLY_BUDGET_USD=
# Preços por milhão de tokens, do site oficial da Anthropic. O app NÃO traz preços padrão (nada de números inventados):
# AI_PRICES_JSON={"<nome-do-modelo>":{"inPerMTok":0,"outPerMTok":0}}
AI_PRICES_JSON=

# Open Food Facts (consulta por código de barras). O OFF pede um contato no User-Agent:
# ex.: OFF_CONTACT=contato@seudominio.com. Em branco, o User-Agent fica só "Bocado/1.0".
OFF_CONTACT=

# ---- Login com Google (opcional; sem isso o botão não aparece) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
