# ---- Banco ----
POSTGRES_USER=bocado
# Use só caracteres seguros para URL: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=bocado

# ---- App ----
# URL pública do app (sem barra no final), ex.: https://bocado.seudominio.com
APP_URL=
# Mínimo 32 caracteres: openssl rand -hex 32
JWT_SECRET=
# Deixe true em produção (HTTPS). Use false só em http://localhost
COOKIE_SECURE=true

# ---- IA (análise por foto e descrição) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Open Food Facts (consulta por código de barras). O OFF pede um contato no User-Agent:
# ex.: OFF_CONTACT=contato@seudominio.com. Em branco, o User-Agent fica só "Bocado/1.0".
OFF_CONTACT=

# ---- Login com Google (opcional; sem isso o botão não aparece) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
